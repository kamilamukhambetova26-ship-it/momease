# Секрет для подписи сессий. ОБЯЗАТЕЛЬНО задайте свой в продакшене.
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# PostgreSQL для продакшена (Neon, Supabase, Railway, свой сервер).
# Если переменная не задана, сайт использует встроенный PostgreSQL (PGlite)
# и хранит данные в папке .data/pglite — удобно для разработки.
# DATABASE_URL=postgres://user:password@host:5432/momease

# Первые пользователи, которых создаёт `npm run db:seed`
ADMIN_EMAIL=admin@momease.kz
ADMIN_PASSWORD=change-me-admin-password
MANAGER_EMAIL=manager@momease.kz
MANAGER_PASSWORD=change-me-manager-password

# Email-уведомления (необязательно). Без SMTP_URL письма не отправляются,
# уведомления всё равно видны на сайте.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="momease <no-reply@example.com>"
# Адрес сайта для ссылок в письмах
# APP_URL=https://momease.example.com
